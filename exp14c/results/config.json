{
  "dataset": "MNIST",
  "model": "dp_kfac.models.SimpleCNN",
  "betas": [
    0.0,
    0.25,
    0.5,
    0.75,
    1.0
  ],
  "estimators": [
    "KFLR",
    "KFRA-block"
  ],
  "seeds": [
    42,
    7
  ],
  "epochs": 5,
  "batch_size": 256,
  "shuffle": true,
  "drop_last": true,
  "optimizer": "SGD",
  "learning_rate": 0.5,
  "momentum": 0,
  "weight_decay": 0,
  "epsilon": 1.0,
  "delta": 1e-05,
  "max_grad_norm": 1.0,
  "damping": 0.001,
  "noise_multiplier": 1.068115234375,
  "sample_rate": 0.004266666666666667,
  "accountant_steps": 1170,
  "accounting": "RDP; exp11 shuffled fixed-batch convention",
  "train_samples": 60000,
  "synthetic_batches": 10,
  "synthetic_batch_size": 256,
  "rebuild": "once per epoch",
  "synthetic_seed": "seed + 10000 + epoch",
  "label_seed": "seed + 20000 + epoch",
  "noise_seed": "seed + 40000",
  "shuffle_seed": "seed",
  "smoke": false,
  "cudnn_benchmark": false,
  "cudnn_deterministic": true,
  "matmul_tf32": false,
  "cudnn_tf32": false,
  "scale_matching": "estimator-local synthetic curvature global RMS",
  "scale_reference_beta": 0.5,
  "scale_match": "sqrt(m_0.5 / m_beta) on current run/epoch factors",
  "disposable_warmup": true,
  "cost_metric": "algorithm_epoch_seconds",
  "preconditioner_build_seconds": "cache + curvature + factor power + scale matching",
  "algorithm_epoch_seconds": "preconditioner_build_seconds + private_train_seconds",
  "wall_epoch_seconds": "algorithm_epoch_seconds + geometry_seconds + state_metric_seconds + evaluation_seconds"
}
